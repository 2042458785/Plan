# 本文件仅作域名部署的备用示例；当前 IP 部署请使用 nginx.ip.conf。
# 两个域名分别部署，不要把 admin/dist_end 复制进顾客站点。
# 域名与证书需按你的实际环境填写；此文件仅为代理边界示例。
server {
    listen 80;
    server_name shop.example.com;
    root /srv/suxu/frontend/dist;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    location ~ ^/(admin(?:/|$)|api/v1/admin(?:/|$)) { return 404; }
    location /api/v1/catalog { proxy_pass http://127.0.0.1:8090; proxy_set_header Host $http_host; }
    location /api/v1/media/ { proxy_pass http://127.0.0.1:8090; proxy_set_header Host $http_host; }
    location /api/v1/orders { proxy_pass http://127.0.0.1:8090; proxy_set_header Host $http_host; }
    location / { try_files $uri $uri/ /index.html; }
}
server {
    listen 80;
    server_name merchant.example.com;
    client_max_body_size 6m;
    root /srv/suxu/admin/dist_end;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    location /api/ { proxy_pass http://127.0.0.1:8090; proxy_set_header Host $http_host; }
    location / { try_files $uri $uri/ /index.html; }
}
